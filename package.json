    "react-dom": "^19.1.0",
    "react-loading-skeleton": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
