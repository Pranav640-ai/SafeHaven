    "api": "node scripts/start-api.mjs",
    "test:web": "playwright test",
    "android:emulator": "node scripts/android-emulator.mjs",
    "test:mesh": "node scripts/test-mesh-emulators.mjs",
    "android:release:prepare": "node scripts/prepare-android-release.mjs",
    "test:scenario": ".venv\\Scripts\\python.exe scripts/test-disaster-scenario.py"
